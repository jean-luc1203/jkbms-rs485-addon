-        "func": "// =========== BMS DATA PROCESSING - STABLE HA DISCOVERY VERSION ===========\n\n// ISSUE #166: prevent bad BMS IDs from reaching any MQTT or state path.\nconst raw166 = msg.bms_numero;\nconst parsed166 = (typeof raw166 === \"string\" && raw166.toLowerCase() === \"master\")\n    ? 0 : (typeof raw166 === \"number\" || (typeof raw166 === \"string\" && /^(0|[1-9]|1[0-5])$/.test(raw166)))\n        ? Number(raw166) : NaN;\nif (!Number.isInteger(parsed166) || parsed166 < 0 || parsed166 > 15) {\n    node.warn(\"ISSUE #166: invalid DATA BMS identifier \" + String(raw166) + \", dropped\");\n    return null;\n}\nmsg.bms_numero = parsed166;\n\n// 0. Récupération adresse BMS et conversion en \"master\" si nécessaire\nlet bmsAdresse = msg.bms_numero;\nlet slaveIdStr;\n\nif (typeof bmsAdresse === \"string\" && bmsAdresse.toLowerCase() === \"master\") {\n    slaveIdStr = \"master\";\n} else if (!isNaN(Number(bmsAdresse))) {\n    if (Number(bmsAdresse) === 0) {\n        slaveIdStr = \"master\";\n    } else {\n        slaveIdStr = String(Number(bmsAdresse));\n    }\n} else {\n    slaveIdStr = \"master\";\n}\n\nvar payload = msg.payload || {};\n// 4.1.12-alpha1: LIVE DRY bits decoded only when byte 281 is present.\nconst legacyDryLiveRaw = Object.prototype.hasOwnProperty.call(payload, \"dry_status_N\")\n    ? Number(payload.dry_status_N) : NaN;\nif (Number.isInteger(legacyDryLiveRaw) && legacyDryLiveRaw >= 0 && legacyDryLiveRaw <= 255) {\n    delete payload.dry_status_N; // Expose only read-only binary sensors, not a raw configurable sensor.\n}\n\nvar baseTopic = \"BMS_\" + slaveIdStr;\nvar sensorDiscoveryPrefix = \"homeassistant/sensor\";\nvar binaryDiscoveryPrefix = \"homeassistant/binary_sensor\";\nvar deviceName = \"BMS_\" + slaveIdStr;\nvar deviceID = \"BMS_\" + slaveIdStr + \"_device\";\n\nvar topics = {};\nvar discoveryMsgs = [];\n\nconst discoveryKey = `discoverySent_BMS_${slaveIdStr}`;\nlet discoveryAlreadySent = flow.get(discoveryKey) || false;\n\nconst discoveredKeysStore = `discoveredKeys_BMS_${slaveIdStr}`;\nlet previousDiscoveredKeys = flow.get(discoveredKeysStore) || [];\n\n// ------------------------------------------------------------------\n// 1. Traitement des tensions de cellules\nlet cellCount = Number(flow.get(`jk_cell_count_BMS_${slaveIdStr}`)) || 16;\ncellCount = Math.max(1, Math.min(cellCount, 16));\npayload[\"cell_count_used_N\"] = cellCount;\n\nvar cellVoltages = [];\nvar cellKeys = [];\n\nfor (let i = 1; i <= cellCount; i++) {\n    let key = `Cell_${i}_volt_V`;\n    let voltage = Number(payload[key]);\n    if (Number.isFinite(voltage) && voltage > 0) {\n        cellVoltages.push(voltage);\n        cellKeys.push(key);\n    }\n}\n\nif (cellVoltages.length > 0) {\n    var cellAvgVolt = cellVoltages.reduce((sum, v) => sum + v, 0) / cellVoltages.length;\n    var cellMaxVolt = Math.max(...cellVoltages);\n    var cellMinVolt = Math.min(...cellVoltages);\n    var cellDeltaVolt = cellMaxVolt - cellMinVolt;\n\n    var maxVoltIndex = cellKeys[cellVoltages.indexOf(cellMaxVolt)].match(/Cell_(\\d+)/)[1];\n    var minVoltIndex = cellKeys[cellVoltages.indexOf(cellMinVolt)].match(/Cell_(\\d+)/)[1];\n\n    payload[\"cell_voltage_average_V\"]    = parseFloat(cellAvgVolt.toFixed(3));\n    payload[\"cell_voltage_delta_V\"]      = parseFloat(cellDeltaVolt.toFixed(3));\n    payload[\"cell_voltage_max_number_N\"] = parseInt(maxVoltIndex);\n    payload[\"cell_voltage_min_number_N\"] = parseInt(minVoltIndex);\n    payload[\"cell_voltage_min_value_V\"]  = parseFloat(cellMinVolt.toFixed(3));\n    payload[\"cell_voltage_max_value_V\"]  = parseFloat(cellMaxVolt.toFixed(3));\n} else {\n    payload[\"cell_voltage_average_V\"]    = 0;\n    payload[\"cell_voltage_delta_V\"]      = 0;\n    payload[\"cell_voltage_max_number_N\"] = 0;\n    payload[\"cell_voltage_min_number_N\"] = 0;\n    payload[\"cell_voltage_min_value_V\"]  = 0;\n    payload[\"cell_voltage_max_value_V\"]  = 0;\n}\n\n// ------------------------------------------------------------------\n// 2. Formatage de Total_runtime_S\nif (payload[\"Total_runtime_S\"] !== undefined) {\n    var totalSeconds = parseInt(payload[\"Total_runtime_S\"]);\n    if (!isNaN(totalSeconds)) {\n        var days = Math.floor(totalSeconds / 86400);\n        var remainingSeconds = totalSeconds % 86400;\n        var hours = Math.floor(remainingSeconds / 3600);\n        var minutes = Math.floor((remainingSeconds % 3600) / 60);\n        payload[\"Total_runtime_formatted_T\"] = `${days}D${hours}H${minutes}M`;\n    }\n}\n\n// ------------------------------------------------------------------\n// 3. charge_status_N → texte lisible\nif (payload[\"charge_status_N\"] !== undefined) {\n    var v = parseInt(payload[\"charge_status_N\"]);\n    var txt = \"Unknown\";\n    switch (v) {\n        case 0:\n        case 0x00:\n            txt = \"Bulk\";\n            break;\n        case 1:\n        case 0x01:\n            txt = \"Absorption\";\n            break;\n        case 2:\n        case 0x02:\n            txt = \"Float\";\n            break;\n    }\n    payload[\"charge_status_text_S\"] = txt;\n}\n\n// ------------------------------------------------------------------\n// 4. Formatage charge_status_time_S\nif (payload[\"charge_status_time_S\"] !== undefined) {\n    var s = parseInt(payload[\"charge_status_time_S\"]);\n    if (!isNaN(s)) {\n        var days = Math.floor(s / 86400);\n        var rem = s % 86400;\n        var hours = Math.floor(rem / 3600);\n        var minutes = Math.floor((rem % 3600) / 60);\n        var seconds = rem % 60;\n\n        if (days > 0)\n            payload[\"charge_status_time_formatted_T\"] = `${days}D${hours}H${minutes}M`;\n        else if (hours > 0)\n            payload[\"charge_status_time_formatted_T\"] = `${hours}H${minutes}M${seconds}S`;\n        else if (minutes > 0)\n            payload[\"charge_status_time_formatted_T\"] = `${minutes}M${seconds}S`;\n        else\n            payload[\"charge_status_time_formatted_T\"] = `${seconds}S`;\n    }\n}\n\n// ------------------------------------------------------------------\n// 5. Formatage Heating_B\nif (payload[\"Heating_B\"] !== undefined) {\n    var heatingStatus = parseInt(payload[\"Heating_B\"]);\n    var heatingTxt = heatingStatus === 1 ? \"ON\" : \"OFF\";\n    payload[\"Heating_status_text_S\"] = heatingTxt;\n}\n\n// ------------------------------------------------------------------\n// 6. Préparation topics + clés discovery\nconst allowedSuffixes = [\"_V\", \"_A\", \"_W\", \"_T\", \"_Ah\", \"_R\", \"_P\", \"_S\", \"_B\", \"_N\"];\nlet currentDiscoveredKeys = [];\n\nfor (var key in payload) {\n    var hasValidSuffix = allowedSuffixes.some(s => key.endsWith(s));\n    if (!hasValidSuffix) continue;\n\n    var cleanKey = key.replace(/_[A-Z]+$/, \"\");\n    currentDiscoveredKeys.push(cleanKey);\n\n    var sensorTopic = `${baseTopic}/${cleanKey}`;\n    topics[sensorTopic] = payload[key];\n}\n\n// Republie le discovery si nouvelles clés\nlet newKeys = currentDiscoveredKeys.filter(k => !previousDiscoveredKeys.includes(k));\nlet shouldSendDiscovery = !discoveryAlreadySent || newKeys.length > 0;\n\n// ------------------------------------------------------------------\n// 7. Génération discovery\nfor (var key in payload) {\n    var hasValidSuffix = allowedSuffixes.some(s => key.endsWith(s));\n    if (!hasValidSuffix) continue;\n\n    var cleanKey = key.replace(/_[A-Z]+$/, \"\");\n    var sensorTopic = `${baseTopic}/${cleanKey}`;\n\n    if (!shouldSendDiscovery) continue;\n    if (discoveryAlreadySent && !newKeys.includes(cleanKey)) continue;\n\n    // Booléens -> binary_sensor\n    if (key.endsWith(\"_B\")) {\n        var binaryConfigTopic = `${binaryDiscoveryPrefix}/${deviceID}_${cleanKey}/config`;\n\n        var binaryConfigPayload = {\n            name: cleanKey,\n            unique_id: `${deviceID}_bms_${cleanKey}_v4`,\n            state_topic: sensorTopic,\n            payload_on: \"1\",\n            payload_off: \"0\",\n            device: {\n                identifiers: [deviceID],\n                name: deviceName,\n                manufacturer: \"Smartphoton-JK-BMS / ©JLM 2025-2026\",\n                model: \"JK-BMS - RS485\",\n                sw_version: \"3.5\"\n            },\n            icon: \"mdi:toggle-switch\"\n        };\n\n        if (key === \"Heating_B\") {\n            binaryConfigPayload.icon = \"mdi:heating-coil\";\n        } else if (key === \"Switch_Charge_B\") {\n            binaryConfigPayload.icon = \"mdi:battery-charging\";\n        } else if (key === \"Switch_Decharge_B\") {\n            binaryConfigPayload.icon = \"mdi:battery-minus\";\n        } else if (key === \"Balance_Action_B\" || key === \"Switch_Balance_B\") {\n            binaryConfigPayload.icon = \"mdi:battery-sync\";\n        }\n\n        // Force l'entity_id HA stable pour les binary_sensor data broadcasting\n        binaryConfigPayload.object_id = `${baseTopic.toLowerCase()}_bms_${cleanKey}`;\n        binaryConfigPayload.default_entity_id = `binary_sensor.${binaryConfigPayload.object_id}`;\n\n        discoveryMsgs.push({\n            topic: `${binaryDiscoveryPrefix}/${binaryConfigPayload.object_id}/config`,\n            payload: JSON.stringify(binaryConfigPayload),\n            retain: true\n        });\n\n        continue;\n    }\n\n    // Capteurs standards\n    var configTopic = `${sensorDiscoveryPrefix}/${deviceID}_${cleanKey}/config`;\n\n    var configPayload = {\n        name: cleanKey,\n        unique_id: `${deviceID}_bms_${cleanKey}_v4`,\n        state_topic: sensorTopic,\n        unit_of_measurement: \"\",\n        entity_category: \"diagnostic\",\n        device: {\n            identifiers: [deviceID],\n            name: deviceName,\n            manufacturer: \"Smartphoton-JK-BMS / ©JLM 2025-2026\",\n            model: \"JK-BMS - RS485\",\n            sw_version: \"3.5\"\n        }\n    };\n\n    if (key.endsWith(\"_V\")) {\n        configPayload.unit_of_measurement = \"V\";\n        configPayload.device_